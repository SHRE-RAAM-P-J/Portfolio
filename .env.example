# Google Analytics 4 — optional (page views + custom events)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics — automatic on Vercel deploy (dashboard: visits, sources, devices).

# Supabase — real-time analytics (visits, active users, event tracking)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Upstash Redis (Vercel integration) for legacy counter API fallback
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Without Redis, /api/analytics uses CountAPI as fallback when Supabase is unavailable.
